# ---------------------------------------------------------------------------
# Copy to .env and replace every value marked CHANGE_ME.
# Generate secrets with:  openssl rand -base64 48
# Never commit .env. In production inject variables from a secret manager.
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Comma-separated list of allowed browser origins. Empty = CORS disabled.
CORS_ORIGINS=http://localhost:5173
# true only when running behind a trusted reverse proxy / load balancer
TRUST_PROXY=false
# Swagger defaults to enabled outside production and disabled in production
SWAGGER_ENABLED=true

# Global rate limit (per client IP)
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=100

# Bearer token Prometheus must send to scrape /metrics (min 32 chars)
METRICS_TOKEN=CHANGE_ME_metrics_token_at_least_32_characters

# JWT access tokens (HS256). Secret min 32 chars.
JWT_ACCESS_SECRET=CHANGE_ME_access_secret_at_least_32_characters
JWT_ISSUER=__APP_NAME__
JWT_AUDIENCE=__APP_NAME__-clients
# #if db
JWT_ACCESS_TTL_SECONDS=900

# Opaque refresh tokens (rotated on every use, stored hashed)
REFRESH_TOKEN_TTL_DAYS=7
DEFAULT_USER_SCOPES=profile:read

# PostgreSQL
POSTGRES_USER=__APP_DB__
POSTGRES_PASSWORD=CHANGE_ME_db_password
POSTGRES_DB=__APP_DB__
DATABASE_URL=postgres://__APP_DB__:CHANGE_ME_db_password@localhost:5432/__APP_DB__
DATABASE_SSL=false
DATABASE_POOL_MAX=10
# #endif

# Grafana admin (docker-compose only)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_grafana_password
